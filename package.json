{
  "name": "nextstep",
  "version": "2.1.0",
  "private": true,
  "description": "NextStep — o'zbek tilida til o'rganish platformasi (statik sayt)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/tailwind.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o assets/tailwind.css --watch",
    "build:tests": "node tools/generate-tests.js",
    "build": "npm run build:css && npm run build:tests"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  }
}
